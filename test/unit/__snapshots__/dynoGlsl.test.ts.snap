"uniform float value_8;

uniform vec4 value_9;

uniform vec3 value_10;

struct Gsplat {
  vec3 center;
  uint flags;
  vec3 scales;
  int index;
  vec4 quaternion;
  vec4 rgba;
};
const uint GSPLAT_FLAG_ACTIVE = 1u << 0u;

bool isGsplatActive(uint flags) {
  return (flags & GSPLAT_FLAG_ACTIVE) != 0u;
}

vec3 gsplatNormal(vec3 scales, vec4 quaternion) {
  float minScale = min(scales.x, min(scales.y, scales.z));
  vec3 normal;
  if (scales.z == minScale) {
    normal = vec3(0.0, 0.0, 1.0);
  } else if (scales.y == minScale) {
    normal = vec3(0.0, 1.0, 0.0);
  } else {
    normal = vec3(1.0, 0.0, 0.0);
  }
  return quatVec(quaternion, normal);
}
void main() {
    // DynoBlock(gsplat) => (out_gsplat)
    {
        // DynoFloat() => (value_8)
        
        // DynoVec4() => (value_9)
        
        // DynoVec3() => (value_10)
        
        // TransformGsplat(gsplat, value_8, value_9, value_10) => (gsplat_7)
        Gsplat gsplat_7;
        {
            gsplat_7 = gsplat;
            if (isGsplatActive(gsplat_7.flags)) {
                gsplat_7.center *= value_8;
                gsplat_7.center = quatVec(value_9, gsplat_7.center);
                gsplat_7.center += value_10;
                gsplat_7.scales *= value_8;
                gsplat_7.quaternion = quatQuat(value_9, gsplat_7.quaternion);
            }
        }
        
        // SplitGsplat(gsplat_7) => (center_6)
        vec3 center_6;
        {
            center_6 = gsplat_7.center;
        }
        
        // GsplatNormal(gsplat_7) => (normal_11)
        vec3 normal_11;
        {
            normal_11 = gsplatNormal(gsplat_7.scales, gsplat_7.quaternion);
        }
        
        // Dot(center_6, normal_11) => (dot_5)
        float dot_5;
        {
            dot_5 = dot(center_6, normal_11);
        }
        
        // GreaterThanEqual(dot_5, 0.0) => (greaterThanEqual_4)
        bool greaterThanEqual_4;
        {
            greaterThanEqual_4 = dot_5 >= 0.0;
        }
        
        // GsplatNormal(gsplat) => (normal_13)
        vec3 normal_13;
        {
            normal_13 = gsplatNormal(gsplat.scales, gsplat.quaternion);
        }
        
        // Neg(normal_13) => (neg_12)
        vec3 neg_12;
        {
            neg_12 = -normal_13;
        }
        
        // Select(greaterThanEqual_4, neg_12, normal_13) => (select_3)
        vec3 select_3;
        {
            select_3 = (greaterThanEqual_4) ? (neg_12) : (normal_13);
        }
        
        // Mul(select_3, 0.5) => (product_2)
        vec3 product_2;
        {
            product_2 = select_3 * 0.5;
        }
        
        // Add(product_2, 0.5) => (sum_1)
        vec3 sum_1;
        {
            sum_1 = product_2 + 0.5;
        }
        
        // CombineGsplat(gsplat, sum_1) => (out_gsplat)
        {
            out_gsplat.flags = gsplat.flags;
            out_gsplat.index = gsplat.index;
            out_gsplat.center = gsplat.center;
            out_gsplat.scales = gsplat.scales;
            out_gsplat.quaternion = gsplat.quaternion;
            out_gsplat.rgba = gsplat.rgba;
            out_gsplat.rgba.rgb = sum_1;
        }
    }
}
